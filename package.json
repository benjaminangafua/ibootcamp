{
  "name": "ibootcamp-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "tsc -b && node --import tsx scripts/build-content.ts && vite build && node --import tsx scripts/prerender.mjs",
    "check": "tsc -b && node --import tsx --test src/content.test.ts && node --import tsx scripts/check-render.tsx",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "linkedom": "^0.18.12",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
